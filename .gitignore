# ── Personal / secret files ──────────────────────────────
# If you keep your real Firebase credentials in firebase-config.js
# and want to gitignore it, uncomment the line below.
# Then use firebase-config.example.js as the committed template.
firebase-config.js

# ── OS junk ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Temp / local ─────────────────────────────────────────
*.xlsx
*.csv
~$*
.claude/

# Statements and other documents dropped in for parsing — never commit these
*.pdf
