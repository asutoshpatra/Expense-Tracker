rules_version = '2';

// ExpendIQ — one document per account, reachable only by that account.
//
// A Firebase web API key is public by design: it names the project, it grants
// nothing. These rules are the only thing standing between the data and anyone
// who opens the deployed page and reads the source. Do not relax them to
// `if true` — that is read and delete access for the whole internet.
//
// The document id is the signed-in user's uid, which is what makes the match
// below possible. Contents are AES-GCM encrypted on the device before upload,
// so even a rules failure or a database compromise yields ciphertext.

service cloud.firestore {
  match /databases/{database}/documents {

    match /expiq/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Anything not matched above stays denied.
  }
}
